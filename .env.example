# 这是可以提交到 GitHub 的空白模板，禁止在本文件中填写真实值。
# 本地使用时请复制为 .env，再把真实值写入 .env：
# cp .env.example .env
FUDAN_USERNAME=
FUDAN_PASSWORD=
# 可选：只有 UIS 明确要求 TOTP 二次认证时才需要。
FUDAN_TOTP_SECRET=
# 可选：Node 24 可执行文件路径；GitHub Actions 中填写 node 即可。
FUDAN_NODE_BIN=node

QQ_SMTP_USERNAME=
QQ_SMTP_AUTH_CODE=
NOTIFICATION_EMAIL=
